# Mosaic Environment Configuration

# Application
APP_NAME=Mosaic
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Phase 2 external signals (token optional; never sent to the frontend)
GITHUB_TOKEN=
SIGNAL_CACHE_DIR=backend/.cache/signals
SIGNAL_CACHE_TTL_SECONDS=21600
SIGNAL_HTTP_TIMEOUT_SECONDS=8
# Leave unset to disable POST /seed/rebuild (403).
ADMIN_KEY=

# Phase 4 AI providers. Gemini is primary and Groq is the automatic fallback.
# Leave both empty to disable AI chat, briefs, and interview questions.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30

# Optional Phase 4 Neo4j knowledge graph. All three values are required.
# Graph endpoints return an informative unavailable response when omitted.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
# Seed ready candidate contexts into Neo4j in background tasks.
GRAPH_SEEDING_ENABLED=false

# Phase 5 database and connection pool (use postgresql+asyncpg in production)
DATABASE_URL=sqlite+aiosqlite:///./mosaic.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Required in production. Generate a long random value and never prefix it with VITE_.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional: google, github, or clerk
OAUTH_PROVIDER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
SIGNAL_CACHE_TTL_DAYS=90
AUTO_SEED_DB=false
E2E_BOOTSTRAP_USERS=false
# Public provider label used only to render the OAuth login button.
VITE_OAUTH_PROVIDER=
